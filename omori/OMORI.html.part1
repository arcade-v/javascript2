<style>
.IIV::-webkit-media-controls-play-button,video::-webkit-media-controls-start-playback-button{opacity:0;pointer-events:none;width:5px}#mobileControls{position:fixed;top:0;left:0;right:0;bottom:0;z-index:2147483645;pointer-events:none;display:none;justify-content:space-between;align-items:center;box-sizing:border-box;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:manipulation}#mctrlLeftPanel{pointer-events:auto;display:flex;align-items:center;justify-content:center;flex-shrink:0}#mctrlRightPanel{pointer-events:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;flex-shrink:0}.mctrl-btn{pointer-events:auto;border:2px solid rgb(255 255 255 / .35);border-radius:12px;background:rgb(20 20 30 / .55);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);color:rgb(255 255 255 / .85);font-family:'GameFont',monospace,sans-serif;font-size:15px;display:flex;align-items:center;justify-content:center;text-align:center;cursor:pointer;transition:background 0.08s,transform 0.08s}.mctrl-btn:active,.mctrl-btn.pressed{background:rgb(255 255 255 / .25);border-color:rgb(255 255 255 / .6);transform:scale(.93)}#mctrlDpad{pointer-events:auto;position:relative;width:150px;height:150px;flex-shrink:0}.mctrl-dpad-btn{position:absolute;width:46px;height:46px;border:2px solid rgb(255 255 255 / .35);border-radius:10px;background:rgb(20 20 30 / .55);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);color:rgb(255 255 255 / .7);font-size:18px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background 0.08s,transform 0.08s;touch-action:manipulation}.mctrl-dpad-btn:active,.mctrl-dpad-btn.pressed{background:rgb(255 255 255 / .3);border-color:rgb(255 255 255 / .65);transform:scale(.9)}#mctrlDpadUp{top:0;left:52px}#mctrlDpadDown{bottom:0;left:52px}#mctrlDpadLeft{top:52px;left:0}#mctrlDpadRight{top:52px;right:0}#mctrlDpadCenter{position:absolute;top:52px;left:52px;width:46px;height:46px;border-radius:50%;background:rgb(255 255 255 / .08);pointer-events:none}#mctrlActionRow{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;align-items:center}.mctrl-action{width:50px;height:50px;border-radius:50%;font-size:15px;font-weight:700}.mctrl-action-sm{width:40px;height:40px;border-radius:50%;font-size:12px}#mctrlBtnZ{background:rgb(80 60 180 / .55);border-color:rgb(160 140 255 / .5)}#mctrlBtnZ:active,#mctrlBtnZ.pressed{background:rgb(140 110 255 / .4);border-color:rgb(180 160 255 / .8)}#mctrlBtnX{background:rgb(180 50 50 / .5);border-color:rgb(255 120 120 / .5)}#mctrlBtnX:active,#mctrlBtnX.pressed{background:rgb(240 80 80 / .45);border-color:rgb(255 150 150 / .8)}#mctrlBtnShift{font-size:11px;background:rgb(50 120 50 / .5);border-color:rgb(100 200 100 / .5)}#mctrlBtnShift:active,#mctrlBtnShift.pressed{background:rgb(80 180 80 / .45);border-color:rgb(140 240 140 / .8)}#mctrlToggle{position:fixed;top:8px;left:8px;z-index:2147483647;pointer-events:auto;width:36px;height:36px;border-radius:50%;border:2px solid rgb(255 255 255 / .35);background:rgb(20 20 30 / .6);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);color:rgb(255 255 255 / .8);font-size:16px;display:none;align-items:center;justify-content:center;cursor:pointer;touch-action:manipulation}
</style>
