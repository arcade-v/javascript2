<body style="background-color: black; overflow: hidden; margin: 0;"> <div id="dataConfirm" style=" display: none; flex-direction: column; justify-content: center; align-items: center; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.95); z-index: 2147483648; font-family: 'GameFont', monospace; color: #fff; text-align: center; padding: 24px; box-sizing: border-box; "> <div style="font-size: 20px; margin-bottom: 10px; letter-spacing: 3px;">DATA USAGE WARNING</div> <div style="max-width: 420px; font-size: 13px; line-height: 1.6; color: #ddd; margin-bottom: 8px;"> Starting will download roughly <b style="color:#ffd27f;">287 MB</b> of game files to your browser, requiring roughly <b style="color:#ffd27f;">280 MB</b> of storage. On a metered or mobile connection this can<span id="dataMetaWarning" style="display:none;"> consume a significant amount of data and</span> take a while. Please only proceed if you want to continue. </div> <div style="font-size: 11px; color: #888; margin-bottom: 22px;"> These files are cached for future visits, so this download normally happens only once. </div> <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;"> <button id="dataConfirmCancel" type="button" style=" padding: 10px 20px; border: 1px solid rgba(255,255,255,0.35); border-radius: 5px; background: rgba(255,255,255,0.08); color: #ccc; font: inherit; font-size: 12px; letter-spacing: 1px; cursor: pointer; ">LEAVE</button> <button id="dataConfirmBegin" type="button" style=" padding: 11px 26px; border: 1px solid rgba(255,210,127,0.9); border-radius: 5px; background: linear-gradient(180deg, #ffb347, #e0811f); box-shadow: 0 4px 18px rgba(255,170,70,0.35), inset 0 1px rgba(255,255,255,0.3); color: #3a2200; font: inherit; font-size: 13px; letter-spacing: 2px; font-weight: bold; cursor: pointer; transition: transform .15s ease, filter .15s ease; ">START DOWNLOAD</button> </div> </div> <div id="zipProgress" style=" display: flex; flex-direction: column; align-items: center; position: fixed; inset: 0; overflow-y: auto; background: #000; z-index: 2147483646; font-family: 'GameFont', monospace; color: #fff; padding: 24px; box-sizing: border-box; "> <div id="launcherBox" style=" width: min(860px, 92vw); background: #000; border: 2px solid #fff; border-radius: 0; padding: 28px 24px 34px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; margin: auto; "> <div id="zipProgressHeader" style="font-size: clamp(16px, 3vw, 24px); margin-bottom: 16px; letter-spacing: 2px; color: #ccc;">LOADING ASSETS</div> <div id="zipProgressMainBar" style="width: min(340px, 80vw); height: 6px; background: #222; border-radius: 3px; overflow: hidden; border: 1px solid #444;"> <div id="zipProgressFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #6a5acd, #b19cd9); border-radius: 3px; transition: width 0.3s ease;"></div> </div> <div id="zipProgressLabel" style="font-size: 12px; margin-top: 10px; color: #888;">Initializing...</div> <div id="zipProgressImages" style="margin-top: 18px; width: min(340px, 80vw); text-align: left;"> <div style="font-size: 10px; letter-spacing: 2px; color: #9aa; margin-bottom: 4px;">IMAGES</div> <div style="width: 340px; height: 5px; background: #222; border-radius: 3px; overflow: hidden; border: 1px solid #444;"> <div id="zipProgressImageFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #4aa8e8, #7fc7ff); border-radius: 3px; transition: width 0.3s ease;"></div> </div> <div id="zipProgressImageLabel" style="font-size: 11px; margin-top: 5px; color: #888;"></div> </div> <div id="zipProgressAudio" style="margin-top: 14px; width: min(340px, 80vw); text-align: left;"> <div style="font-size: 10px; letter-spacing: 2px; color: #9aa; margin-bottom: 4px;">AUDIO</div> <div style="width: 340px; height: 5px; background: #222; border-radius: 3px; overflow: hidden; border: 1px solid #444;"> <div id="zipProgressAudioFill" style="width: 0%; height: 100%; background: linear-gradient(90deg, #46c98a, #86e6b4); border-radius: 3px; transition: width 0.3s ease;"></div> </div> <div id="zipProgressAudioLabel" style="font-size: 11px; margin-top: 5px; color: #888;"></div> </div> <div id="modUploader" style="display: none; margin-top: 18px; text-align: center; width: 100%; max-width: min(860px, 92vw); box-sizing: border-box;"> <div style="font-size: clamp(18px, 2.6vw, 24px); letter-spacing: 4px; color: #ccc; margin-bottom: 12px;">MODS</div> <label for="modFileInput" style=" display: inline-block; padding: clamp(12px, 1.6vw, 16px) clamp(24px, 3.2vw, 36px); border: 1px dashed rgba(200,180,255,0.55); border-radius: 4px; color: #cdc3f2; font: inherit; font-size: clamp(15px, 1.9vw, 19px); letter-spacing: 1px; cursor: pointer; transition: border-color .2s, background .2s; " onmouseover="this.style.borderColor='rgba(200,180,255,0.9)';this.style.background='rgba(200,180,255,0.08)'" onmouseout="this.style.borderColor='rgba(200,180,255,0.55)';this.style.background='transparent'"> + ADD MODS (.zip, multi-select) </label> <input type="file" id="modFileInput" accept=".zip,.omod,application/zip" multiple style="display: none;"> <div id="modList" style="margin-top: 14px; text-align: left; max-height: clamp(320px, 42vh, 520px); overflow-y: auto;"></div> <div id="modInfo" style="margin-top: 10px; font-size: clamp(13px, 1.6vw, 16px); color: #8f8;"></div> <div id="modWarn" style="margin-top: 6px; font-size: clamp(12px, 1.4vw, 15px); color: #f88; white-space: pre-wrap;"></div> </div> <div id="saveUploader" style="display: none; margin-top: 24px; width: 100%; flex-direction: column; align-items: center; gap: 12px; font-family: 'GameFont', monospace; color: #fff;"> <div id="saveUploaderDivider" style="width: 100%; height: 1px; background: rgba(255,255,255,0.25);"></div> <div id="saveUploaderHead" style="display: flex; align-items: center; justify-content: space-between; width: 100%;" onclick="toggleSavePanel()"> <div id="saveUploaderTitle" style="font-size: clamp(18px, 2.6vw, 24px); letter-spacing: 4px; color: #ccc; cursor: default;">SAVES</div> <div id="savePanelToggle" style="width: 34px; height: 34px; flex: 0 0 34px; line-height: 30px; text-align: center; border: 2px solid #fff; background: #000; color: #fff; font-size: 22px; cursor: pointer; user-select: none;">&#8722;</div> </div> <div id="saveUploaderBody" style="display: flex; flex-direction: column; align-items: center; gap: 12px; width: 100%;"> <span id="saveUploadStatus" style="font-size: 12px; letter-spacing: 1px; color: #5f5; text-align: center; white-space: pre-wrap; min-height: 15px; line-height: 1.4;"></span> <div id="saveUploaderButtons" style="display: flex; gap: 12px; justify-content: center;"> <label for="saveFileInput" style="display: block; padding: 11px 24px; border: 2px solid #fff; background: #000; color: #fff; font: inherit; font-size: 13px; letter-spacing: 2px; text-align: center; cursor: pointer; transition: background .15s ease, color .15s ease;" onmouseover="this.style.background='#fff';this.style.color='#000'" onmouseout="this.style.background='#000';this.style.color='#fff'">UPLOAD SAVE</label> <button type="button" id="exportSavesButton" style="padding: 11px 24px; border: 2px solid #fff; background: #000; color: #fff; font: inherit; font-size: 13px; letter-spacing: 2px; text-align: center; cursor: pointer; transition: background .15s ease, color .15s ease;" onmouseover="this.style.background='#fff';this.style.color='#000'" onmouseout="this.style.background='#000';this.style.color='#fff'" onclick="handleSaveExport(event)">EXPORT SAVES</button> </div> <input type="file" id="saveFileInput" accept=".rpgsave" multiple style="display: none;" onchange="handleSaveUpload(event)"> <div style="margin-top: 10px; font-size: 14px; color: #999; letter-spacing: 1px; text-align: center; line-height: 1.5;">NOTE: refresh after uploading a save for it to take effect.</div> </div> </div> <script>function toggleSavePanel(){var b=document.getElementById('saveUploaderBody');var t=document.getElementById('savePanelToggle');var h=document.getElementById('saveUploaderTitle');var d=document.getElementById('saveUploaderDivider');if(!b||!t)return;var open=b.style.display!=='none';if(open){b.style.display='none';h.style.display='none';d.style.display='none';t.innerHTML='&#43;';t.style.background='#fff';t.style.color='#000';}else{b.style.display='flex';h.style.display='';d.style.display='';t.innerHTML='&#8722;';t.style.background='#000';t.style.color='#fff';}}</script> <button id="zipLaunchButton" type="button" style=" display: none; margin-top: 24px; padding: clamp(12px, 2.5vw, 22px) clamp(40px, 9vw, 72px); border: 2px solid #fff; border-radius: 0; background: #000; color: #fff; font: inherit; font-size: clamp(16px, 4vw, 26px); letter-spacing: 3px; cursor: pointer; transition: background .15s ease, color .15s ease; outline: none; " onmouseover="this.style.background='#fff';this.style.color='#000'" onmouseout="this.style.background='#000';this.style.color='#fff'">LAUNCH</button> <div id="madeByStg" style="position: fixed; bottom: 10px; right: 14px; font-family: 'GameFont', monospace; font-size: 13px; letter-spacing: 2px; pointer-events: none; user-select: none; z-index: 2147483647;"></div> <script>(function(){var el=document.getElementById('madeByStg');if(!el)return;var t='MADE BY STG';for(var i=0;i<t.length;i++){var s=document.createElement('span');s.textContent=t[i]===' '?'\u00a0':t[i];s.style.color=(i%2===0)?'#9a9a9a':'#ffffff';s.style.textShadow=(i%2===0)?'0 0 10px rgba(255,255,255,0.12)':'0 0 10px rgba(255,255,255,0.35)';el.appendChild(s);}})();</script> </div> </div> <button id="mctrlToggle" type="button" title="H">🟢</button> <div id="mobileControls"> <div id="mctrlLeftPanel"> <div id="mctrlDpad"> <button class="mctrl-dpad-btn" id="mctrlDpadUp" type="button">▲</button> <button class="mctrl-dpad-btn" id="mctrlDpadDown" type="button">▼</button> <button class="mctrl-dpad-btn" id="mctrlDpadLeft" type="button">◀</button> <button class="mctrl-dpad-btn" id="mctrlDpadRight" type="button">▶</button> <div id="mctrlDpadCenter"></div> </div> </div> <div id="mctrlRightPanel"> <div id="mctrlActionRow"> <button class="mctrl-btn mctrl-action-sm" id="mctrlBtnQ" type="button">Q</button> <button class="mctrl-btn mctrl-action" id="mctrlBtnZ" type="button">Z</button> </div> <div id="mctrlActionRow"> <button class="mctrl-btn mctrl-action-sm" id="mctrlBtnW" type="button">W</button> <button class="mctrl-btn mctrl-action" id="mctrlBtnX" type="button">X</button> </div> <div id="mctrlActionRow"> <button class="mctrl-btn mctrl-action-sm" id="mctrlBtnA" type="button">A</button> <button class="mctrl-btn mctrl-action" id="mctrlBtnShift" type="button">RUN</button> </div> </div> </div> <script>window.__pluginBundle = 'js/plugins.bundle.js';</script> <script>
(function () {
    'use strict';

    var DECODED = Object.create(null);   // canonical key -> Uint8Array
    var DATAURIS = Object.create(null);  // canonical key -> data: URI
    var BLOBS = Object.create(null);     // canonical key -> blob: URL
    var PAYLOADS = null;                 // canonical key -> <script data-sf> element
    var KEYS = null;                     // lowercase key -> canonical key
    var BYBASE = null;                   // basename -> canonical key

    var PAGE_DIR = '';
    try { PAGE_DIR = window.location.pathname.replace(/[^/]*$/, ''); } catch (e) {}

    // Same URL -> payload-key reduction the ZipLoader uses for its VFS paths:
    // drop the query/hash, take the pathname of absolute URLs, strip the page's
    // own directory, then the leading slash(es).
    function norm(u) {
        if (u === null || u === undefined) return '';
        var s = String(u);
        var h = s.indexOf('#');
        if (h >= 0) s = s.slice(0, h);
        var q = s.indexOf('?');
        if (q >= 0) s = s.slice(0, q);
        if (/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(s)) {
            var scheme = s.slice(0, s.indexOf(':')).toLowerCase();
            if (scheme === 'blob' || scheme === 'data') return '';
            try { s = new URL(s, window.location.href).pathname; } catch (e) {}
        }
        try { s = decodeURIComponent(s); } catch (e) {}
        s = s.replace(/\\/g, '/');
        if (PAGE_DIR && s.indexOf(PAGE_DIR) === 0) s = s.slice(PAGE_DIR.length);
        s = s.replace(/^\.\//, '');
        while (s.charAt(0) === '/') s = s.slice(1);
        return s;
    }

    function index() {
        if (PAYLOADS) return;
        PAYLOADS = Object.create(null);
        KEYS = Object.create(null);
        BYBASE = Object.create(null);
        var els = document.querySelectorAll('script[data-sf]');
        for (var i = 0; i < els.length; i++) {
            var key = els[i].getAttribute('data-sf');
            if (!key) continue;
            PAYLOADS[key] = els[i];
            KEYS[key.toLowerCase()] = key;
            var base = key.slice(key.lastIndexOf('/') + 1);
            if (BYBASE[base] === undefined) BYBASE[base] = key;
        }
    }

    function canonical(key) {
        if (!key) return '';
        index();
        if (PAYLOADS[key] !== undefined) return key;
        var lower = KEYS[key.toLowerCase()];
        if (lower !== undefined) return lower;
        // Last resort for URLs built from an unexpected base (a blob: script's
        // own directory, say): match on the file name alone. Every payload key
        // has a unique file name.
        var base = key.slice(key.lastIndexOf('/') + 1);
        return BYBASE[base] === undefined ? '' : BYBASE[base];
    }

    // Unpack one payload element: 7 bits per character, back into bytes.
    function unpack(text, byteLen) {
        var out = new Uint8Array(byteLen);
        var acc = 0;
        var bits = 0;
        var oi = 0;
        var n = text.length;
        for (var i = 0; i < n && oi < byteLen; i++) {
            var cp = text.charCodeAt(i);
            var sym;
            if (cp < 0x0d) sym = cp - 1;
            else if (cp <= 0x7f) sym = cp - 2;
            else if (cp === 0x80) sym = 126;
            else sym = 127;
            acc = (acc << 7) | sym;
            bits += 7;
            if (bits >= 8) {
                bits -= 8;
                out[oi++] = (acc >>> bits) & 0xff;
                acc &= (1 << bits) - 1;
            }
        }
        return out;
    }

    function bytes(key) {
        var canon = canonical(key);
        if (!canon) return null;
        if (DECODED[canon]) return DECODED[canon];
        var el = PAYLOADS[canon];
        if (!el) return null;
        var text = el.textContent || '';
        var len = Number(el.getAttribute('data-n')) || Math.floor((text.length * 7) / 8);
        var out = unpack(text, len);
        DECODED[canon] = out;
        el.textContent = ''; // the packed text is dead weight once unpacked
        return out;
    }

    function toBase64(buf) {
        var s = '';
        var CHUNK = 0x8000;
        for (var i = 0; i < buf.length; i += CHUNK) {
            s += String.fromCharCode.apply(null, buf.subarray(i, i + CHUNK));
        }
        return btoa(s);
    }

    function mime(key) {
        var k = key.toLowerCase();
        if (/\.png$/.test(k)) return 'image/png';
        if (/\.jpe?g$/.test(k)) return 'image/jpeg';
        if (/\.gif$/.test(k)) return 'image/gif';
        if (/\.ogg$/.test(k)) return 'audio/ogg';
        if (/\.m4a$/.test(k)) return 'audio/mp4';
        if (/\.mp3$/.test(k)) return 'audio/mpeg';
        if (/\.webm$/.test(k)) return 'video/webm';
        if (/\.mp4$/.test(k)) return 'video/mp4';
        if (/\.wasm$/.test(k)) return 'application/wasm';
        if (/\.json$/.test(k)) return 'application/json';
        if (/\.ya?ml$/.test(k)) return 'text/yaml';
        if (/\.js$/.test(k)) return 'text/javascript';
        if (/\.css$/.test(k)) return 'text/css';
        if (/\.html?$/.test(k)) return 'text/html';
        if (/\.ttf$/.test(k)) return 'font/ttf';
        if (/\.otf$/.test(k)) return 'font/otf';
        if (/\.woff2?$/.test(k)) return 'font/woff';
        if (/\.txt$/.test(k)) return 'text/plain';
        if (/\.ini$/.test(k)) return 'text/plain';
        if (/\.zip$/.test(k) || /\.part\d+$/.test(k)) return 'application/zip';
        return 'application/octet-stream';
    }

    function dataUri(key) {
        var canon = canonical(key);
        if (!canon) return null;
        if (DATAURIS[canon]) return DATAURIS[canon];
        var b = bytes(canon);
        if (!b) return null;
        var uri = 'data:' + mime(canon) + ';base64,' + toBase64(b);
        DATAURIS[canon] = uri;
        return uri;
    }

    function blobUrl(key) {
        var canon = canonical(key);
        if (!canon) return null;
        if (BLOBS[canon]) return BLOBS[canon];
        var b = bytes(canon);
        if (!b) return null;
        BLOBS[canon] = URL.createObjectURL(new Blob([b], { type: mime(canon) }));
        return BLOBS[canon];
    }

    function rangeHeaderOf(headers) {
        if (!headers) return '';
        try {
            if (typeof headers.get === 'function') {
                return headers.get('range') || headers.get('Range') || '';
            }
            if (Array.isArray(headers)) {
                for (var i = 0; i < headers.length; i++) {
                    if (String(headers[i][0]).toLowerCase() === 'range') return String(headers[i][1]);
                }
                return '';
            }
            for (var k in headers) {
                if (Object.prototype.hasOwnProperty.call(headers, k) && k.toLowerCase() === 'range') {
                    return String(headers[k]);
                }
            }
        } catch (e) {}
        return '';
    }

    function parseRange(value, total) {
        var m = /^bytes=(\d*)-(\d*)$/.exec(String(value).trim());
        if (!m || (m[1] === '' && m[2] === '')) return null;
        var start;
        var end;
        if (m[1] === '') {
            start = Math.max(0, total - parseInt(m[2], 10));
            end = total - 1;
        } else {
            start = parseInt(m[1], 10);
            end = m[2] === '' ? total - 1 : parseInt(m[2], 10);
        }
        if (end >= total) end = total - 1;
        if (start >= total || start > end) return { invalid: true };
        return { start: start, end: end };
    }

    function respond(canon, range, method) {
        var b = bytes(canon);
        if (!b) return new Response('', { status: 404 });
        if (method === 'HEAD') {
            return new Response(null, {
                status: 200,
                headers: { 'Content-Type': mime(canon), 'Content-Length': String(b.length), 'Accept-Ranges': 'bytes' }
            });
        }
        if (range) {
            var r = parseRange(range, b.length);
            if (r && r.invalid) {
                return new Response(null, { status: 416, headers: { 'Content-Range': 'bytes */' + b.length } });
            }
            if (r) {
                var slice = b.slice(r.start, r.end + 1);
                return new Response(slice, {
                    status: 206,
                    headers: {
                        'Content-Type': mime(canon),
                        'Content-Range': 'bytes ' + r.start + '-' + r.end + '/' + b.length,
                        'Content-Length': String(slice.length),
                        'Accept-Ranges': 'bytes',
                        'Access-Control-Allow-Origin': '*'
                    }
                });
            }
        }
        return new Response(b, {
            status: 200,
            headers: {
                'Content-Type': mime(canon),
                'Content-Length': String(b.length),
                'Accept-Ranges': 'bytes',
                'Cache-Control': 'no-store'
            }
        });
    }

    // ---- fetch ---------------------------------------------------------------
    var nativeFetch = (typeof window.fetch === 'function') ? window.fetch.bind(window) : null;

    window.fetch = function (input, init) {
        var url = '';
        var method = 'GET';
        var headers = null;
        if (typeof input === 'string') {
            url = input;
        } else if (input && typeof input === 'object') {
            url = input.url || '';
            if (input.method) method = input.method;
            headers = input.headers || null;
        }
        var key = canonical(norm(url));
        if (!key) {
            return nativeFetch ? nativeFetch(input, init)
                : Promise.reject(new TypeError('Failed to fetch: ' + url));
        }
        if (init && init.method) method = init.method;
        var hdrs = (init && init.headers) ? init.headers : headers;
        return Promise.resolve(respond(key, rangeHeaderOf(hdrs), String(method).toUpperCase()));
    };

    // ---- XMLHttpRequest -----------------------------------------------------
    // Native XHR, pointed at a blob: URL for payload files. Relative URLs of VFS
    // paths (data/, maps/, img/, audio/) are left alone: ZipLoader's own XHR
    // hook answers those before the request ever reaches the network.
    var nativeOpen = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function (method, url) {
        var args = Array.prototype.slice.call(arguments);
        try {
            var key = canonical(norm(url));
            if (key) {
                var bu = blobUrl(key);
                if (bu) args[1] = bu;
            }
        } catch (e) {}
        return nativeOpen.apply(this, args);
    };

    // ---- <script src> / <video src> ----------------------------------------
    function rewriteUrl(url) {
        if (typeof url !== 'string' || url === '') return url;
        var key = canonical(norm(url));
        if (!key) return url;
        return blobUrl(key) || url;
    }

    var scriptSrcDesc = Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype, 'src');
    if (scriptSrcDesc && scriptSrcDesc.set) {
        Object.defineProperty(HTMLScriptElement.prototype, 'src', {
            get: scriptSrcDesc.get,
            set: function (url) { scriptSrcDesc.set.call(this, rewriteUrl(url)); },
            configurable: true
        });
    }

    var mediaSrcDesc = Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype, 'src');
    if (mediaSrcDesc && mediaSrcDesc.set) {
        Object.defineProperty(HTMLMediaElement.prototype, 'src', {
            get: mediaSrcDesc.get,
            set: function (url) { mediaSrcDesc.set.call(this, rewriteUrl(url)); },
            configurable: true
        });
    }

    // ---- launcher boot gate -------------------------------------------------
    // The stock launcher opens on a one-time "this will download ~287 MB"
    // consent screen and only starts once the player accepts. A single file
    // already holds every byte, so there is nothing to download and nothing to
    // consent to: hasCachedArchives() is the single input to that decision, so
    // wrap it the instant ZipLoader installs itself.
    //
    // The accessor starts undefined (not null) so "typeof ZipLoader" keeps
    // reporting "undefined" until the game really creates it, exactly as it did
    // before this hook existed.
    var realZipLoader;
    try {
        Object.defineProperty(window, 'ZipLoader', {
            configurable: true,
            get: function () { return realZipLoader; },
            set: function (value) {
                realZipLoader = value;
                if (value && typeof value.hasCachedArchives === 'function') {
                    value.hasCachedArchives = function () { return Promise.resolve(true); };
                }
            }
        });
    } catch (e) {}

    // ---- public surface -----------------------------------------------------
    window.__SF = {
        norm: norm,
        has: function (key) { return !!canonical(key); },
        bytes: bytes,
        dataUri: dataUri,
        blobUrl: blobUrl,
        count: function () { index(); return Object.keys(PAYLOADS).length; }
    };
})();

