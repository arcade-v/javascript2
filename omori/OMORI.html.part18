//-----------------------------------------------------------------------------
// PluginManager
//
// The static class that manages the plugins.

function PluginManager() {
    throw new Error('This is a static class');
}

PluginManager._path         = 'js/plugins/';
PluginManager._scripts      = [];
PluginManager._errorUrls    = [];
PluginManager._parameters   = {};
// A deployment can ship every enabled plugin inside one plain .js file rather
// than 150 of them, so a host that dislikes the request count, the file names
// or the extension only ever sees one (see tools/build_plugin_bundle.js). The
// page opts in by setting window.__pluginBundle to that path before this bundle
// runs. Nothing is read until the first plugin is asked for, and if the file is
// not deployed every plugin loads from js/plugins/<name>.js as usual.
PluginManager._bundlePath    = null;
PluginManager._bundleFiles   = null;
PluginManager._bundlePromise = null;
PluginManager._bundleError   = null;

PluginManager.pluginBundlePath = function() {
    if (this._bundlePath === null) {
        var configured = (typeof window !== 'undefined') ? window.__pluginBundle : null;
        this._bundlePath = configured || '';
    }
    return this._bundlePath;
};

// Split the bundle back into { 'js/plugins/<name>.js': source } on the marker
// lines the generator writes. A marker is followed by that plugin's exact
// source bytes and then one separating newline, which the strip removes, so
// each plugin runs from the same bytes as its file on disk.
PluginManager.splitPluginBundle = function(text) {
    var files = {};
    var marker = /^;\/\*==== plugin: (.+?) ====\*\/$/gm;
    var match = null;
    var name = null;
    var start = 0;
    while ((match = marker.exec(text)) !== null) {
        if (name !== null) files[this._path + name] = text.slice(start, match.index).replace(/\n$/, '');
        name = match[1];
        start = match.index + match[0].length + 1;
    }
    if (name !== null) files[this._path + name] = text.slice(start).replace(/\n$/, '');
    return files;
};

// The bundled source for one plugin URL, or null when this build ships its
// plugins individually. The file is fetched once; a missing or unreadable
// bundle is not fatal, it just means the per-plugin files are used instead.
PluginManager.pluginBundleText = function(url) {
    var self = this;
    if (this._bundleFiles) return Promise.resolve(this._bundleFiles[url] || null);
    var path = this.pluginBundlePath();
    if (!path || this._bundleError) return Promise.resolve(null);
    if (typeof fetch !== 'function') return Promise.resolve(null);
    if (!this._bundlePromise) {
        this._bundlePromise = fetch(path).then(function(response) {
            if (!response.ok) throw new Error('HTTP ' + response.status);
            return response.text();
        }).then(function(text) {
            self._bundleFiles = self.splitPluginBundle(text);
            console.log('PluginManager: ' + Object.keys(self._bundleFiles).length +
                ' plugin source(s) read from ' + path + ' (single-file build)');
            return self._bundleFiles;
        }).catch(function(error) {
            self._bundleError = (error && error.message) || String(error);
            var message = 'PluginManager: ' + path + ' unusable (' + self._bundleError +
                '); loading js/plugins/*.js individually';
            if (/HTTP 404/.test(self._bundleError)) console.log(message);
            else console.warn(message);
            return null;
        });
    }
    return this._bundlePromise.then(function(files) {
        return files ? (files[url] || null) : null;
    });
};

PluginManager.setup = function(plugins) {
    var self = this;
    // Dynamic script elements are not guaranteed to have executed when the
    // next line of main.js runs. Load the enabled plugins in project order and
    // resolve only after each script has actually executed, so plugin hooks
    // (notably Omori Name Input's input initializer) exist before SceneManager
    // starts its first frame.
    return plugins.reduce(function(chain, plugin) {
        if (!plugin.status || self._scripts.contains(plugin.name)) {
            return chain;
        }
        return chain.then(function() {
            self.setParameters(plugin.name, plugin.parameters);
            return self.loadScript(plugin.name + '.js').then(function() {
                self._scripts.push(plugin.name);
            });
        });
    }, Promise.resolve());
};

PluginManager.loadScript = function(name) {
    var url = this._path + name;
    // Mods overlay js/plugins/* into the browser VFS. When a plugin is present
    // there (a modded or mod-patched plugin), execute it from a Blob URL with
    // the same global scope and ordered-by-promise semantics as on-disk
    // plugins, without a network request.
    var vfsText = null;
    if (typeof ZipLoader !== 'undefined' && ZipLoader.getText) {
        vfsText = ZipLoader.getText(url);
    }
    if (vfsText != null) {
        return this._loadScriptFromBlob(name, url, vfsText);
    }
    // Single-file plugin builds hold the same source here; it is executed the
    // same way a mod-overlaid plugin is, so its parameters are already in place.
    var self = this;
    return this.pluginBundleText(url).then(function(bundleText) {
        if (bundleText != null) return self._loadScriptFromBlob(name, url, bundleText);
        return self._loadScriptFromFile(name, url);
    });
};

// The plain per-plugin <script src="js/plugins/<name>.js"> load, kept separate
// so loadScript can decide where a plugin's source comes from first.
PluginManager._loadScriptFromFile = function(name, url) {
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = url;
    script.async = false;
    script._url = url;
    return new Promise(function(resolve, reject) {
        script.onload = function() {
            resolve(script);
        };
        script.onerror = function(event) {
            PluginManager.onError(event);
            reject(new Error('Failed to load: ' + url));
        };
        document.body.appendChild(script);
    });
};

PluginManager._loadScriptFromBlob = function(name, url, code) {
    var blob = new Blob([code], { type: 'text/javascript' });
    var blobUrl = URL.createObjectURL(blob);
    var script = document.createElement('script');
    script.type = 'text/javascript';
    script.src = blobUrl;
    script.async = false;
    script._url = url;
    return new Promise(function(resolve, reject) {
        script.onload = function() {
            URL.revokeObjectURL(blobUrl);
            resolve(script);
        };
        script.onerror = function(event) {
            URL.revokeObjectURL(blobUrl);
            PluginManager.onError(event);
            reject(new Error('Failed to load: ' + url));
        };
        document.body.appendChild(script);
    });
};

PluginManager.checkErrors = function() {
    var url = this._errorUrls.shift();
    if (url) {
        throw new Error('Failed to load: ' + url);
    }
};

PluginManager.parameters = function(name) {
    return this._parameters[name.toLowerCase()] || {};
};

PluginManager.setParameters = function(name, parameters) {
    this._parameters[name.toLowerCase()] = parameters;
};

PluginManager.onError = function(e) {
    this._errorUrls.push(e.target._url);
};

//-----------------------------------------------------------------------------
// Decrypter
//
// The static class that handles decryption of encrypted files.
// This version is simplified for use with raw JSON files.

function Decrypter() {
    throw new Error('This is a static class');
}

Decrypter.hasEncryptedImages = false;
Decrypter.hasEncryptedAudio = false;

Decrypter.decrypt = function(source) {
    // No decryption needed - return the source as-is
    return source;
};

Decrypter.extToEncryptExt = function(url) {
    // No encryption - return the URL unchanged
    return url;
};

Decrypter.decryptHTML5Audio = function(url, bgm, pos) {
    // For raw JSON files, just load the audio normally
    AudioManager._blobUrl = url;
    AudioManager._bgmBuffer = AudioManager.createBuffer('bgm', bgm.name);
    AudioManager.updateBgmParameters(bgm);
    if (!AudioManager._meBuffer) {
        AudioManager._bgmBuffer.play(true, pos || 0);
    }
};

Decrypter.checkImgIgnore = function(url) {
    // No image ignore check needed for raw files
    return false;
};



