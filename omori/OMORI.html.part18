                    return part;
                }, function(err) {
                    clearTimeout(timer);
                    if (timedOut) throw new Error('ZipLoader: stream stalled for ' + url);
                    throw err;
                });
            }
            function read() {
                return readChunkWithWatchdog().then(function(part) {
                    if (part.done) {
                        var result = new Uint8Array(loaded);
                        var offset = 0;
                        chunks.forEach(function(chunk) {
                            result.set(chunk, offset);
                            offset += chunk.length;
